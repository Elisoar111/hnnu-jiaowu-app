<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下的云备份规则（full-backup-content）。

  这里放行的是 sharedpref / database 两个域，并显式排除**含会话凭证**的两个文件：

  - secure_credentials.xml：账号密码的 Keystore 密文。密文本身离不开本机的
    AndroidKeyStore 密钥，换设备恢复后必然解不开（代码里只能删掉走"请重新登录"），
    把它传上云既没用又多一份被离线爆破的素材，直接不备份。
  - course_selector_prefs.xml：saved_cookie（当前会话 Cookie）、saved_accounts
    （每个账号一条记录，内含 Cookie）。会话 Cookie 被恢复到另一台设备 =
    任何人都能拿着它冒充已登录用户。

  ⚠️ 平台规则只能按**文件**排除，做不到"只排除某个 key"。所以只要某条会话数据
  还和普通设置混在同一个 SharedPreferences 里，就只能连整个文件一起排除。
  会话状态本来就该"换设备重新登录"，这里排除整文件是刻意为之：
  想保留的普通设置都已拆在独立文件（schedule_settings / appearance_settings /
  app_prefs / grab_pro_prefs 等），不受影响。
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />

    <exclude domain="sharedpref" path="secure_credentials.xml" />
    <exclude domain="sharedpref" path="course_selector_prefs.xml" />
</full-backup-content>
