<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片里的一行（时间 + 课程名 + 状态）。由 CardWidgetRenderer 动态 addView。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/card_row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="44dp"
        android:textColor="#536078"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/card_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#1D2433"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/card_row_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#345DC4"
        android:textSize="11sp" />
</LinearLayout>
