<resources>
    <color name="startup_background">#F0F2F4</color>
    <!-- 启动闪屏：不再使用自绘的旧 Logo，直接用应用图标（mipmap/ic_launcher）。 -->
    <style name="Theme.CourseSelector.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.CourseSelector</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>
</resources>
