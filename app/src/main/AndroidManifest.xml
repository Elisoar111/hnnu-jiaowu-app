<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 后台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 相册读取：只用于"用户自己挑一张图当头像"。
         点「更换头像」时**先检查并按需申请**权限，再打开系统相册——部分 ROM 的相册
         在无权限时会让选图这一步静默失败，应用连"读不到"都收不到，表现为
         "头像读不出来"。所以不再只做失败兜底。
         READ_EXTERNAL_STORAGE 在 13 起已被 READ_MEDIA_IMAGES 取代，限高版本声明；
         READ_MEDIA_VISUAL_USER_SELECTED 对应 Android 14 的"仅允许访问选中的照片"。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- 定时任务权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- 应用更新权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 扫码签到：第二课堂的签到码必须现场扫（qutuo:// 明文载荷）。
         相机是"可选硬件"：没有摄像头的设备照样能装，只是扫码入口会提示不可用。
         运行时权限由 zxing 的 CaptureActivity 自己申请。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".CourseApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourseSelector"
        tools:targetApi="31">

        <provider
            android:name=".manager.AppearanceThemeProvider"
            android:authorities="${applicationId}.appearance"
            android:exported="false" />
        
        <!-- 竖屏锁定：整套几何是按竖屏手机调的，横屏可用高只剩约 360dp，
             顶栏加底栏会吃掉六成，那是一套从未验过的布局 -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统相机扫到第二课堂签到码（qutuo://sign / qutuo://waitSign）时唤起。
                 解析见 SecondClassDeepLink，签到仍要走 evaluateSignScan 安全闸门。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qutuo" />
            </intent-filter>
            <!-- 点开 / 扫到二课站点的网页链接：不做 autoVerify（没有域名校验文件），
                 系统会弹"用哪个应用打开"，选本 App 直接落到对应活动。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ekta.hnnu.edu.cn"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AcademicWebViewActivity"
            android:configChanges="uiMode"
            android:process=":academic_webview"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 取景框裁剪页：头像与自定义背景共用同一条「选图 → 调整 → 保存」路径 -->
        <activity
            android:name=".ImageCropActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".CourseDetailActivity" android:exported="false" android:configChanges="uiMode" />

        <!-- 扫码相机页强制竖屏：签到码二维码没有方向性，但取景框/提示文案是按竖屏
             设计的；zxing 库自己声明的 CaptureActivity 不锁方向，这里覆盖它。 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <!-- 用户手册阅读页：原生 Compose 渲染 assets/users_manual.json（不再用 WebView） -->
        <activity
            android:name=".ManualActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MessageCenterActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 开发者公告中心：与消息中心同构的整页（未读/已读分段 + 列表 + 详情）。
             公告无需登录，页面本身不打教务接口。 -->
        <activity
            android:name=".AnnouncementActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 学工系统（xg.hnnu.edu.cn）：日常请假 + 节假日去向登记，只读展示。
             该站只有 http，域名已登记在 network_security_config 的明文白名单里。 -->
        <activity
            android:name=".XuegongActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 第二课堂附件查看器：Word / Excel / PDF / 图片 / 文本内置渲染。
             附件是直链（不需要登录态），下载落在 cacheDir/attachments，
             该目录已登记在 file_paths.xml 的 cache-path 下，可被 FileProvider 暴露。 -->
        <activity
            android:name=".ui.document.DocumentViewerActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        
        <!-- Background grab service -->
        <service
            android:name=".service.GrabService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- Scheduled grab alarm receiver -->
        <receiver android:name=".schedule.CourseReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.GrabAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.SCHEDULED_GRAB" />
            </intent-filter>
            <!-- 重启 / 应用更新 / 改时间后系统会清空所有闹钟：选课定时任务需要据此重排，
                 否则用户设好的任务会静默消失（此前只有课程提醒和消息巡检做了重排）。 -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 消息中心每 12 小时巡检一次：有新消息就发系统通知。
             开机 / 应用更新 / 改时间后闹钟会被系统清掉，靠这些广播重排。 -->
        <receiver
            android:name=".academic.MessageCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.MESSAGE_CHECK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 考前 24 小时提醒（一次性闹钟）；开机 / 更新 / 改时间后按本地考试缓存重排。 -->
        <!-- 版本巡检：App 没打开时也能发现新版本并弹系统通知。
             AlarmManager 每天唤一次，收到后自己排下一次（见 UpdateCheckScheduler）。
             不依赖登录态，因此不需要任何 intent-filter。 -->
        <receiver
            android:name=".network.UpdateCheckReceiver"
            android:exported="false" />
        <receiver android:name=".schedule.ExamReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.EXAM_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        
        <!-- FileProvider for sharing iCal files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
    </application>

</manifest>

