<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 通知：课程提醒 / 考试提醒 / 消息中心 / 版本更新 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 相册读取：只用于"用户自己挑一张图当头像"。
         点「更换头像」时**先检查并按需申请**权限，再打开系统相册——部分 ROM 的相册
         在无权限时会让选图这一步静默失败，应用连"读不到"都收不到，表现为
         "头像读不出来"。所以不再只做失败兜底。
         READ_EXTERNAL_STORAGE 在 13 起已被 READ_MEDIA_IMAGES 取代，限高版本声明；
         READ_MEDIA_VISUAL_USER_SELECTED 对应 Android 14 的"仅允许访问选中的照片"。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- 定时任务权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 上课自动模式：切换勿扰需要"勿扰模式访问权限"。
         这是**特殊权限**，只能由用户在系统设置里授予（ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS），
         应用无法自行申请。没有它时 setInterruptionFilter 会抛 SecurityException，静默无效，
         所以代码里是"没权限就绝不施加、施加了必须能还原"。
         不需要 MODIFY_AUDIO_SETTINGS：从 Android N 起改响铃模式本身就等价于开勿扰、
         且同样要求本权限，所以自动模式只走 setInterruptionFilter 一条路径。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 后台电费巡检：申请加入"电池优化白名单"。
         被优化掉的 App 在部分 ROM 上收不到 RTC_WAKEUP 闹钟，表现为"电费提醒时有时无"。
         声明它只是让 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 这个 Intent 可用，
         是否加入仍由用户在系统弹窗里决定。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- 应用更新权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 扫码签到：第二课堂的签到码必须现场扫（qutuo:// 明文载荷）。
         相机是"可选硬件"：没有摄像头的设备照样能装，只是扫码入口会提示不可用。
         运行时权限由 zxing 的 CaptureActivity 自己申请。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".CourseApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourseSelector"
        tools:targetApi="31">

        <provider
            android:name=".manager.AppearanceThemeProvider"
            android:authorities="${applicationId}.appearance"
            android:exported="false" />
        
        <!-- 竖屏锁定：整套几何是按竖屏手机调的，横屏可用高只剩约 360dp，
             顶栏加底栏会吃掉六成，那是一套从未验过的布局 -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统相机扫到第二课堂签到码（qutuo://sign / qutuo://waitSign）时唤起。
                 解析见 SecondClassDeepLink，签到仍要走 evaluateSignScan 安全闸门。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qutuo" />
            </intent-filter>
            <!-- 点开 / 扫到二课站点的网页链接：不做 autoVerify（没有域名校验文件），
                 系统会弹"用哪个应用打开"，选本 App 直接落到对应活动。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ekta.hnnu.edu.cn"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AcademicWebViewActivity"
            android:configChanges="uiMode"
            android:process=":academic_webview"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 取景框裁剪页：头像与自定义背景共用同一条「选图 → 调整 → 保存」路径 -->
        <activity
            android:name=".ImageCropActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 扫码相机页强制竖屏：签到码二维码没有方向性，但取景框/提示文案是按竖屏
             设计的；zxing 库自己声明的 CaptureActivity 不锁方向，这里覆盖它。 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <!-- 用户手册阅读页：原生 Compose 渲染 assets/users_manual.json（不再用 WebView） -->
        <activity
            android:name=".ManualActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MessageCenterActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 开发者公告中心：与消息中心同构的整页（未读/已读分段 + 列表 + 详情）。
             公告无需登录，页面本身不打教务接口。 -->
        <activity
            android:name=".AnnouncementActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 教务系统「考级项目报名」：复用教务会话（jwgl https）；测试账号只读演示 -->
        <activity
            android:name=".KaojiActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 教务系统「空闲教室查询」（cdjy/cdjy_cxKxcdlb.html，gnmkdm=N2155）：
             复用教务会话，只发查询页 GET 与 doType=query 查询 POST。
             不实现网页上的「场地借用申请」——那是向学校提交写请求。 -->
        <activity
            android:name=".EmptyRoomActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 一卡通（yktapp.hnnu.edu.cn）：校园卡余额 + 宿舍电费查看，只读。
             认证走独立的 synjones-auth 令牌，不复用教务会话。
             不提供充值/支付：全站无支付接口，充值是远端子应用。 -->
        <activity
            android:name=".YktActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 一卡通登录页：WebView 走学校统一身份认证（站点只有 sso，无账密接口），
             从 Cookie 里接管 synjones-auth 令牌。独立存储目录，与教务 Cookie 隔离。
             登录成功后令牌落盘，后台电费巡检据此工作。 -->
        <activity
            android:name=".YktLoginActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 一卡通官方页面只读查看器（消费明细/账单等在服务端 jQuery 子应用里，
             不带令牌直接访问 401，无法在客户端复刻，只能交给官方页面渲染）。
             与登录页共用 ykt 存储目录以便免二次认证；本页不导出任何凭据。 -->
        <activity
            android:name=".YktWebActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 第二课堂附件查看器：Word / Excel / PDF / 图片 / 文本内置渲染。
             附件是直链（不需要登录态），下载落在 cacheDir/attachments，
             该目录已登记在 file_paths.xml 的 cache-path 下，可被 FileProvider 暴露。 -->
        <activity
            android:name=".ui.document.DocumentViewerActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:screenOrientation="portrait" />
        
        
        <!-- Scheduled grab alarm receiver -->
        <receiver android:name=".schedule.CourseReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 上课自动模式的上下课闹钟。只有显式 PendingIntent 会打到它，没有任何
             intent-filter（开机/改时间的补偿走上面的 CourseReminderReceiver，它最后会
             整轮 reconcile，自动模式的状态在那一轮里一并对齐）。 -->
        <receiver android:name=".schedule.AutoModeReceiver" android:exported="false" />

        <!-- 桌面小组件：组件工作台里的七种卡片各自一个（下一节课 / 今日课表 / 今日时间轴 /
             考试倒计时 / 成绩概览 / 第二课堂积分 / 未读消息），只读本地缓存，不联网。
             每个 receiver 都要 exported=false：系统发 APPWIDGET_UPDATE 用的是显式组件名，
             外部应用无法伪造（这一点沿用旧课表组件的做法）。
             刷新入口统一走 .widgetboard.CardWidgetUpdater，见下方 CardWidgetRefreshReceiver。 -->
        <receiver android:name=".widgetboard.NextCourseCardWidget" android:exported="false" android:label="@string/card_widget_next_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_next_info" />
        </receiver>
        <receiver android:name=".widgetboard.TodayScheduleCardWidget" android:exported="false" android:label="@string/card_widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_today_info" />
        </receiver>
        <receiver android:name=".widgetboard.TodayTimelineCardWidget" android:exported="false" android:label="@string/card_widget_timeline_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_timeline_info" />
        </receiver>
        <receiver android:name=".widgetboard.ExamCountdownCardWidget" android:exported="false" android:label="@string/card_widget_exam_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_exam_info" />
        </receiver>
        <receiver android:name=".widgetboard.GradesOverviewCardWidget" android:exported="false" android:label="@string/card_widget_grades_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_grades_info" />
        </receiver>
        <receiver android:name=".widgetboard.SecondClassOverviewCardWidget" android:exported="false" android:label="@string/card_widget_secondclass_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_secondclass_info" />
        </receiver>
        <receiver android:name=".widgetboard.MessageUnreadCardWidget" android:exported="false" android:label="@string/card_widget_message_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/card_widget_message_info" />
        </receiver>

        <!-- 桌面卡片的非组件刷新入口：开机 / 应用更新 / 改时间时区日期都会让"正在上课"
             这类判断失真，且系统会清空所有闹钟，需要重画并按新时间重排边界闹钟。
             单独一个 receiver 而不是把这几条 action 挂到 7 个组件上 —— 否则开机时
             会触发 7 次全量重画，而这 7 次做的事完全一样。 -->
        <receiver android:name=".widgetboard.CardWidgetRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 电费余额巡检：每天一次，余额低于阈值就发系统通知。
             开机 / 应用更新 / 改时间后闹钟会被系统清掉，靠这些广播重排。
             只在用户曾打开过一卡通页面（本地有 synjones-auth 令牌）时才真正巡检。 -->
        <receiver
            android:name=".ykt.YktAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.YKT_ALERT_CHECK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 消息中心每 12 小时巡检一次：有新消息就发系统通知。
             开机 / 应用更新 / 改时间后闹钟会被系统清掉，靠这些广播重排。 -->
        <receiver
            android:name=".academic.MessageCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.MESSAGE_CHECK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 考前 24 小时提醒（一次性闹钟）；开机 / 更新 / 改时间后按本地考试缓存重排。 -->
        <!-- 版本巡检：App 没打开时也能发现新版本并弹系统通知。
             AlarmManager 每天唤一次，收到后自己排下一次（见 UpdateCheckScheduler）。
             不依赖登录态，因此不需要任何 intent-filter。 -->
        <receiver
            android:name=".network.UpdateCheckReceiver"
            android:exported="false" />
        <receiver android:name=".schedule.ExamReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.hnnujw.course.action.EXAM_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        
        <!-- FileProvider for sharing iCal files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
    </application>

</manifest>

