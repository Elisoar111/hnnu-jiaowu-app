[
  {
    "name": "完整一轮：开始 → 选答 → 确认答案 → 答题卡 → 提交看总结",
    "mocks": [],
    "steps": [
      {
        "event": { "type": "click", "nodeId": "start", "name": "start" },
        "expect": { "state": { "screen": "practice", "index": 0 }, "nodes": { "stem": { "textContains": "1 字节" } } }
      },
      {
        "event": { "type": "click", "nodeId": "opt.B", "name": "opt.B" },
        "expect": { "state": { "answers": { "b1": "B" }, "index": 0 }, "absent": ["result"] }
      },
      {
        "event": { "type": "click", "nodeId": "confirm", "name": "confirm" },
        "expect": { "nodes": { "result": { "textContains": "回答正确" } } }
      },
      {
        "event": { "type": "click", "nodeId": "next", "name": "next" },
        "expect": { "state": { "index": 1 } }
      },
      {
        "event": { "type": "click", "nodeId": "sheet", "name": "sheet" },
        "expect": { "state": { "screen": "sheet" }, "nodes": { "cell.0": { "label": "1 √" } } }
      },
      {
        "event": { "type": "click", "nodeId": "submit", "name": "submit" },
        "expect": {
          "state": { "screen": "summary" },
          "nodes": { "summary": { "textContains": "正确率 100%" } }
        }
      },
      {
        "event": { "type": "click", "nodeId": "home", "name": "home" },
        "expect": { "state": { "screen": "setup" } }
      }
    ]
  },
  {
    "name": "自动下一题：单选题选完就跳，多选题不跳",
    "context": { "settings": { "autoNext": true } },
    "mocks": [],
    "steps": [
      {
        "event": { "type": "click", "nodeId": "start", "name": "start" },
        "expect": { "state": { "screen": "practice", "autoNext": true, "index": 0 } }
      },
      {
        "event": { "type": "click", "nodeId": "opt.B", "name": "opt.B" },
        "expect": { "state": { "index": 1, "answers": { "b1": "B" } } }
      },
      {
        "event": { "type": "click", "nodeId": "sheet", "name": "sheet" }
      },
      {
        "event": { "type": "click", "nodeId": "cell.4", "name": "cell.4" },
        "expect": { "state": { "screen": "practice", "index": 4 }, "nodes": { "chapter": { "textContains": "多选题" } } }
      },
      {
        "event": { "type": "click", "nodeId": "opt.A", "name": "opt.A" },
        "expect": { "state": { "index": 4, "answers": { "b1": "B", "b5": "A" } } }
      },
      {
        "event": { "type": "click", "nodeId": "opt.C", "name": "opt.C" },
        "expect": { "state": { "index": 4, "answers": { "b1": "B", "b5": "AC" } } }
      }
    ]
  },
  {
    "name": "只勾一个章节时只出该章节的题",
    "mocks": [],
    "steps": [
      {
        "event": { "type": "input", "nodeId": "ch.0", "name": "ch.0", "value": true },
        "expect": { "state": { "picked": ["第一章 计算机基础"] } }
      },
      {
        "event": { "type": "click", "nodeId": "start", "name": "start" },
        "expect": { "state": { "screen": "practice", "index": 0 }, "nodes": { "chapter": { "textContains": "第一章" } } }
      },
      {
        "event": { "type": "click", "nodeId": "next", "name": "next" },
        "expect": { "state": { "index": 1 }, "nodes": { "chapter": { "textContains": "第一章" } } }
      }
    ]
  },
  {
    "name": "背题模式不判分，只翻页",
    "mocks": [],
    "steps": [
      {
        "event": { "type": "input", "nodeId": "mode", "name": "mode", "value": "memorize" },
        "expect": { "state": { "mode": "memorize" } }
      },
      {
        "event": { "type": "click", "nodeId": "start", "name": "start" },
        "expect": { "state": { "screen": "practice" } }
      },
      {
        "event": { "type": "click", "nodeId": "opt.A", "name": "opt.A" },
        "expect": { "state": { "answers": {}, "index": 0 } }
      }
    ]
  }
]
